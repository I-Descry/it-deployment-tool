<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IT Deployment Tool" Width="1360" Height="860"
        WindowStartupLocation="CenterScreen"
        Background="#16181D"
        FontFamily="Segoe UI">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="6"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- The default Button chrome swaps in its own system hover/pressed visuals, which can override a custom Background/Foreground and make the label unreadable on hover. This template keeps each button's own colors (via TemplateBinding) and adds only a subtle brightness overlay on hover/press, with the text always painted on top so it never disappears. -->
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"/>
              <Border x:Name="HoverOverlay" Background="#26FFFFFF" CornerRadius="6" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The default ScrollBar is the native Windows gray gripper/track chrome, which clashes badly against this dark flat design. This reduces it to a thin, borderless thumb (matching the mockup's custom-scrollbar spec), faded to low opacity until the pointer is over it so it stays out of the way until it's actually needed. -->
    <Style x:Key="GuiScrollBarThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#33363F" CornerRadius="5" Margin="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.35"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource GuiScrollBarThumb}"/>
                </Track.Thumb>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.9"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The default ProgressBar is a light Aero-gradient bar that also clashes with the dark theme. This is a flat track + fill matching the accent color used everywhere else (checkboxes, primary buttons). -->
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#23262E"/>
      <Setter Property="Foreground" Value="#38BDF8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <Grid ClipToBounds="True">
                <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Plain TextBox/PasswordBox chrome is a flat, hard-cornered rectangle that looks out of place next to the rest of the app's rounded cards and buttons. This softens both to rounded corners matching the existing read-only "current name" display box, and highlights the border with the accent color on focus so a field clearly shows it's active. PART_ContentHost is a required name WPF looks for on both templates to host the actual editable text/password content. -->
    <Style TargetType="TextBox">
      <Setter Property="CaretBrush" Value="#E8E9EC"/>
      <Setter Property="SelectionBrush" Value="#38BDF8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#38BDF8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="CaretBrush" Value="#E8E9EC"/>
      <Setter Property="SelectionBrush" Value="#38BDF8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#38BDF8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <DockPanel x:Name="RootDockPanel" LastChildFill="True">

    <!-- Title bar -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
            Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="0,0,0,1">
      <Grid Margin="14,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="16" Height="16" Margin="0,0,9,0">
            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="12" Height="12" RadiusX="2.4" RadiusY="2.4" Stroke="#38BDF8" StrokeThickness="1.4"/>
            <Path Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6.5 9l1.8 1.8L11.5 7"/>
          </Canvas>
          <TextBlock Text="IT DEPLOYMENT TOOL" Foreground="#C7CAD1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleBarVersionText" Text="-" Foreground="#6B6F79" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Border x:Name="TitleBarMinimizeButton" Width="30" Height="30" Cursor="Hand" Background="Transparent">
            <Canvas Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Line X1="1" Y1="8.2" X2="9" Y2="8.2" Stroke="#9A9EA8" StrokeThickness="1.3"/>
            </Canvas>
          </Border>
          <Border x:Name="TitleBarMaximizeButton" Width="30" Height="30" Cursor="Hand" Margin="8,0,0,0" Background="Transparent">
            <Canvas Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Rectangle Canvas.Left="1.3" Canvas.Top="1.3" Width="7.4" Height="7.4" Stroke="#9A9EA8" StrokeThickness="1.2"/>
            </Canvas>
          </Border>
          <Border x:Name="TitleBarCloseButton" Width="30" Height="30" Cursor="Hand" Margin="8,0,0,0" Background="Transparent">
            <Canvas Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Line X1="1.2" Y1="1.2" X2="8.8" Y2="8.8" Stroke="#9A9EA8" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Line X1="8.8" Y1="1.2" X2="1.2" Y2="8.8" Stroke="#9A9EA8" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14,10,14">
        <StackPanel DockPanel.Dock="Bottom">
          <Border BorderBrush="#2C2F38" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="1,6,1,0">
            <TextBlock x:Name="SidebarFooterText" Text="-" Foreground="#6B6F79" FontSize="10.5" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
        <StackPanel>
        <Border x:Name="NavApplications" Background="#2438BDF8" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavApplicationsIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Rectangle Canvas.Left="2" Canvas.Top="2" Width="7" Height="7" RadiusX="1" RadiusY="1" Stroke="#38BDF8" StrokeThickness="1.4"/>
              <Rectangle Canvas.Left="11" Canvas.Top="2" Width="7" Height="7" RadiusX="1" RadiusY="1" Stroke="#38BDF8" StrokeThickness="1.4"/>
              <Rectangle Canvas.Left="2" Canvas.Top="11" Width="7" Height="7" RadiusX="1" RadiusY="1" Stroke="#38BDF8" StrokeThickness="1.4"/>
              <Rectangle Canvas.Left="11" Canvas.Top="11" Width="7" Height="7" RadiusX="1" RadiusY="1" Stroke="#38BDF8" StrokeThickness="1.4"/>
            </Canvas>
            <TextBlock x:Name="NavApplicationsText" Text="Applications" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border x:Name="NavWindowsSetup" Background="Transparent" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavWindowsSetupIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Path Stroke="#9A9EA8" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M13.5 3.5a3.5 3.5 0 00-4.6 4.2L3 13.6V17h3.4l5.9-5.9a3.5 3.5 0 004.2-4.6l-2.6 2.6-2-2 2.6-2.6z"/>
            </Canvas>
            <TextBlock x:Name="NavWindowsSetupText" Text="Windows Setup" Foreground="#9A9EA8" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border x:Name="NavDeviceDetails" Background="Transparent" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavDeviceDetailsIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Ellipse Canvas.Left="7" Canvas.Top="7" Width="6" Height="6" Stroke="#9A9EA8" StrokeThickness="1.4"/>
              <Path Stroke="#9A9EA8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10 2v2.5M10 15.5V18M18 10h-2.5M4.5 10H2M15.5 4.5l-1.8 1.8M6.3 13.7l-1.8 1.8M15.5 15.5l-1.8-1.8M6.3 6.3L4.5 4.5"/>
            </Canvas>
            <TextBlock x:Name="NavDeviceDetailsText" Text="Device Details" Foreground="#9A9EA8" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <!-- ThinkPad-only, hidden entirely (not just disabled) on any other device: starts Collapsed since IsThinkPad isn't known until the shared Windows Setup/Device Details background load completes. -->
        <Border x:Name="NavAssetId" Background="Transparent" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavAssetIdIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Rectangle Canvas.Left="2" Canvas.Top="4" Width="16" Height="12" RadiusX="1.6" RadiusY="1.6" Stroke="#9A9EA8" StrokeThickness="1.4"/>
              <Line X1="5" Y1="8.5" X2="15" Y2="8.5" Stroke="#9A9EA8" StrokeThickness="1.2"/>
              <Ellipse Canvas.Left="6.5" Canvas.Top="5.6" Width="1.8" Height="1.8" Stroke="#9A9EA8" StrokeThickness="1.1"/>
            </Canvas>
            <TextBlock x:Name="NavAssetIdText" Text="Asset ID" Foreground="#9A9EA8" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border x:Name="NavDeploymentLogs" Background="Transparent" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavDeploymentLogsIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Rectangle Canvas.Left="4" Canvas.Top="2" Width="12" Height="16" RadiusX="1.5" RadiusY="1.5" Stroke="#9A9EA8" StrokeThickness="1.4"/>
              <Line X1="7" Y1="6.5" X2="13" Y2="6.5" Stroke="#9A9EA8" StrokeThickness="1.4"/>
              <Line X1="7" Y1="10" X2="13" Y2="10" Stroke="#9A9EA8" StrokeThickness="1.4"/>
              <Line X1="7" Y1="13.5" X2="11" Y2="13.5" Stroke="#9A9EA8" StrokeThickness="1.4"/>
            </Canvas>
            <TextBlock x:Name="NavDeploymentLogsText" Text="Deployment Logs" Foreground="#9A9EA8" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border x:Name="NavDeploymentValidation" Background="Transparent" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavDeploymentValidationIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Path Stroke="#9A9EA8" StrokeThickness="1.4" Data="M10 2l6.5 2.4v4.8c0 4.7-2.8 7.6-6.5 8.4-3.7-.8-6.5-3.7-6.5-8.4V4.4L10 2z"/>
              <Path Stroke="#9A9EA8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7 10l2 2 4-4"/>
            </Canvas>
            <TextBlock x:Name="NavDeploymentValidationText" Text="Deployment Validation" Foreground="#9A9EA8" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border x:Name="NavTempCleanup" Background="Transparent" CornerRadius="6" Padding="11,9" Margin="0,0,0,2" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NavTempCleanupIcon" Width="20" Height="20" Margin="0,0,10,0">
              <Line X1="4" Y1="6" X2="16" Y2="6" Stroke="#9A9EA8" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
              <Path Stroke="#9A9EA8" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M7 6V4.5a1 1 0 011-1h4a1 1 0 011 1V6"/>
              <Path Stroke="#9A9EA8" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M5.5 6l.8 10a1 1 0 001 1h5.4a1 1 0 001-1l.8-10"/>
              <Line X1="8.5" Y1="8.5" X2="8.8" Y2="14.5" Stroke="#9A9EA8" StrokeThickness="1.2" StrokeStartLineCap="Round"/>
              <Line X1="11.5" Y1="8.5" X2="11.2" Y2="14.5" Stroke="#9A9EA8" StrokeThickness="1.2" StrokeStartLineCap="Round"/>
            </Canvas>
            <TextBlock x:Name="NavTempCleanupText" Text="Temp Cleanup" Foreground="#9A9EA8" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- System info bar -->
      <Border Grid.Row="0" BorderBrush="#2C2F38" BorderThickness="0,0,0,1">
        <DockPanel Margin="24,13,24,13" LastChildFill="False">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <TextBlock Text="Computer " Foreground="#6B6F79" FontSize="12"/>
            <TextBlock x:Name="ComputerNameText" Text="-" Foreground="#E8E9EC" FontSize="12" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="User " Foreground="#6B6F79" FontSize="12"/>
            <TextBlock x:Name="UserNameText" Text="-" Foreground="#E8E9EC" FontSize="12" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="Model " Foreground="#6B6F79" FontSize="12"/>
            <TextBlock x:Name="ModelText" Text="-" Foreground="#E8E9EC" FontSize="12" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="Edition " Foreground="#6B6F79" FontSize="12"/>
            <TextBlock x:Name="EditionText" Text="-" Foreground="#E8E9EC" FontSize="12" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="AdminStatusDot" Width="6" Height="6" Fill="#6B6F79" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="AdminStatusText" Text="Administrator" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <Ellipse x:Name="InternetStatusDot" Width="6" Height="6" Fill="#6B6F79" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="InternetStatusText" Text="Internet" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
              <Ellipse x:Name="WingetStatusDot" Width="6" Height="6" Fill="#6B6F79" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="WingetStatusText" Text="WinGet" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Toolbar -->
      <DockPanel x:Name="ApplicationsToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False">
        <Button x:Name="SelectAllButton" Content="Select All" DockPanel.Dock="Left"
                Padding="14,8" Margin="0,0,10,0" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <Button x:Name="SelectRecommendedButton" Content="Select Recommended" DockPanel.Dock="Left"
                Padding="14,8" Margin="0,0,10,0" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <Button x:Name="ClearAllButton" Content="Clear All" DockPanel.Dock="Left"
                Padding="14,8" Margin="0,0,10,0" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>

        <Button x:Name="CancelQueueButton" Content="Cancel" DockPanel.Dock="Right"
                Padding="18,9" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="13" FontWeight="Bold"
                Visibility="Collapsed"/>
        <Button x:Name="UninstallSelectedButton" Content="Uninstall Selected" DockPanel.Dock="Right"
                Padding="18,9" Background="#1AF2555A" Foreground="#F2555A"
                BorderBrush="#F2555A" BorderThickness="1.5" FontSize="13" FontWeight="Bold"/>
        <Button x:Name="InstallSelectedButton" Content="Install Selected" DockPanel.Dock="Right"
                Padding="18,9" Margin="0,0,10,0" Background="#38BDF8" Foreground="#08131A"
                BorderThickness="0" FontSize="13" FontWeight="Bold"/>
        <StackPanel x:Name="QueueProgressPanel" DockPanel.Dock="Right" VerticalAlignment="Center"
                    Width="340" Margin="0,0,14,0" Visibility="Collapsed">
          <TextBlock x:Name="QueueProgressText" Text="-" Foreground="#E8E9EC" FontSize="12"
                     FontWeight="SemiBold" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="QueueProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
        <TextBlock x:Name="SelectedCountText" Text="0 selected" DockPanel.Dock="Right"
                   Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
      </DockPanel>

      <!-- Deployment Validation toolbar -->
      <DockPanel x:Name="DeploymentValidationToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False" Visibility="Collapsed">
        <Button x:Name="RerunValidationButton" Content="Re-run Validation" DockPanel.Dock="Right"
                Padding="18,9" Background="#38BDF8" Foreground="#08131A"
                BorderThickness="0" FontSize="13" FontWeight="Bold"/>
        <TextBlock x:Name="ValidationSummaryText" Text="" DockPanel.Dock="Right"
                   Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="16" Height="16" Margin="0,0,9,0">
              <Path Stroke="#38BDF8" StrokeThickness="1.4" Data="M8 1.5l5.5 2v4c0 4-2.4 6.3-5.5 7-3.1-.7-5.5-3-5.5-7v-4L8 1.5z"/>
              <Path Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5.5 8l1.8 1.8L10.5 6"/>
            </Canvas>
            <TextBlock Text="Deployment Validation" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Confirms this device is ready and configured installer packages are available." Foreground="#9A9EA8" FontSize="11.5" Margin="25,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Deployment Logs toolbar -->
      <DockPanel x:Name="DeploymentLogsToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False" Visibility="Collapsed">
        <Button x:Name="OpenLogsFolderButton" Content="Open Logs Folder" DockPanel.Dock="Right"
                Padding="14,8" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <Button x:Name="RefreshLogsButton" Content="Refresh" DockPanel.Dock="Right"
                Padding="14,8" Margin="0,0,10,0" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="16" Height="16" Margin="0,0,9,0">
              <Rectangle Canvas.Left="3.5" Canvas.Top="1.5" Width="9" Height="13" RadiusX="1.2" RadiusY="1.2" Stroke="#38BDF8" StrokeThickness="1.4"/>
              <Line X1="6" Y1="5" X2="10" Y2="5" Stroke="#38BDF8" StrokeThickness="1.2"/>
              <Line X1="6" Y1="7.7" X2="10" Y2="7.7" Stroke="#38BDF8" StrokeThickness="1.2"/>
              <Line X1="6" Y1="10.4" X2="8.7" Y2="10.4" Stroke="#38BDF8" StrokeThickness="1.2"/>
            </Canvas>
            <TextBlock Text="Deployment Logs" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Review past deployment sessions and their recorded outcomes." Foreground="#9A9EA8" FontSize="11.5" Margin="25,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Temp Cleanup toolbar -->
      <DockPanel x:Name="TempCleanupToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False" Visibility="Collapsed">
        <Button x:Name="CleanSelectedTempButton" Content="Clean Selected" DockPanel.Dock="Right"
                Padding="18,9" Background="#38BDF8" Foreground="#08131A"
                BorderThickness="0" FontSize="13" FontWeight="Bold"/>
        <Button x:Name="RefreshTempCleanupButton" Content="Refresh" DockPanel.Dock="Right"
                Padding="14,8" Margin="0,0,10,0" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="16" Height="16" Margin="0,0,9,0">
              <Line X1="3.2" Y1="4.8" X2="12.8" Y2="4.8" Stroke="#38BDF8" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
              <Path Stroke="#38BDF8" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M5.6 4.8V3.6a0.8 0.8 0 01.8-.8h3.2a0.8 0.8 0 01.8.8v1.2"/>
              <Path Stroke="#38BDF8" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M4.4 4.8l.6 8a0.8 0.8 0 00.8.8h4.4a0.8 0.8 0 00.8-.8l.6-8"/>
            </Canvas>
            <TextBlock Text="Temp Cleanup" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Reviews and clears temp/cache locations before handing off this device." Foreground="#9A9EA8" FontSize="11.5" Margin="25,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Windows Setup toolbar -->
      <DockPanel x:Name="WindowsSetupToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False" Visibility="Collapsed">
        <Button x:Name="RefreshWindowsSetupButton" Content="Refresh" DockPanel.Dock="Right"
                Padding="14,8" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="16" Height="16" Margin="0,0,9,0">
              <Path Stroke="#38BDF8" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M10.8 2.8a2.8 2.8 0 00-3.7 3.4L2.4 10.9V13.6h2.7l4.7-4.7a2.8 2.8 0 003.4-3.7l-2.1 2.1-1.6-1.6 2.1-2.1z"/>
            </Canvas>
            <TextBlock Text="Windows Setup" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Rename this device, create a local user, and configure power settings." Foreground="#9A9EA8" FontSize="11.5" Margin="25,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Device Details toolbar -->
      <DockPanel x:Name="DeviceDetailsToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False" Visibility="Collapsed">
        <Button x:Name="RefreshDeviceDetailsButton" Content="Refresh" DockPanel.Dock="Right"
                Padding="14,8" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <Button x:Name="CopyDeviceDetailsButton" Content="Copy Device Details" DockPanel.Dock="Right" Margin="0,0,10,0"
                Padding="14,8" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="16" Height="16" Margin="0,0,9,0">
              <Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6" Stroke="#38BDF8" StrokeThickness="1.4"/>
              <Path Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M8 1.6v2M8 12.4v2M14.4 8h-2M3.6 8h-2M12.4 3.6l-1.4 1.4M4.9 11.1l-1.4 1.4M12.4 12.4l-1.4-1.4M4.9 4.9L3.6 3.6"/>
            </Canvas>
            <TextBlock Text="Device Details" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Full identity, system, session, and hardware profile for this device." Foreground="#9A9EA8" FontSize="11.5" Margin="25,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Asset ID toolbar: ThinkPad-only, matching NavAssetId's own Collapsed default -->
      <DockPanel x:Name="AssetIdToolbar" Grid.Row="1" Margin="24,14,24,10" LastChildFill="False" Visibility="Collapsed">
        <Button x:Name="RefreshAssetIdButton" Content="Refresh" DockPanel.Dock="Right"
                Padding="14,8" Background="#23262E" Foreground="#E8E9EC"
                BorderBrush="#2C2F38" BorderThickness="1" FontSize="12.5"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="16" Height="16" Margin="0,0,9,0">
              <Rectangle Canvas.Left="1.5" Canvas.Top="3" Width="13" Height="10" RadiusX="1.3" RadiusY="1.3" Stroke="#38BDF8" StrokeThickness="1.3"/>
              <Line X1="4" Y1="7" X2="12" Y2="7" Stroke="#38BDF8" StrokeThickness="1.1"/>
              <Ellipse Canvas.Left="5.2" Canvas.Top="4.2" Width="1.6" Height="1.6" Stroke="#38BDF8" StrokeThickness="1"/>
            </Canvas>
            <TextBlock Text="Lenovo Asset ID" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Edit and save this ThinkPad's BIOS asset-tracking fields." Foreground="#9A9EA8" FontSize="11.5" Margin="25,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Applications grid -->
      <ScrollViewer x:Name="ApplicationsScrollViewer" Grid.Row="2" Padding="24,4,24,24" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="AppGridPanel">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>

      <!-- Deployment validation content -->
      <ScrollViewer x:Name="DeploymentValidationScrollViewer" Grid.Row="2" Padding="24,4,24,24" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel x:Name="DeploymentValidationPanel"/>
      </ScrollViewer>

      <!-- Deployment logs content -->
      <Grid x:Name="DeploymentLogsContent" Grid.Row="2" Margin="24,4,24,24" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="RECENT SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#9A9EA8" Margin="4,0,0,10"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DeploymentLogsPanel"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Padding="16,12">
              <StackPanel Orientation="Horizontal">
                <Canvas Width="14" Height="14" Margin="0,0,8,0">
                  <Rectangle Canvas.Left="3" Canvas.Top="1" Width="8" Height="12" RadiusX="1" RadiusY="1" Stroke="#9A9EA8" StrokeThickness="1.3"/>
                  <Line X1="5.2" Y1="4.5" X2="8.8" Y2="4.5" Stroke="#9A9EA8" StrokeThickness="1.1"/>
                  <Line X1="5.2" Y1="7" X2="8.8" Y2="7" Stroke="#9A9EA8" StrokeThickness="1.1"/>
                </Canvas>
                <TextBlock x:Name="SelectedLogNameText" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#E8E9EC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <TextBox x:Name="LogContentTextBox"
                     Background="Transparent" Foreground="#E8E9EC" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="14"
                     IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Windows Setup content: three action cards side by side. The Lenovo Asset ID card used to live below them; it's now its own ThinkPad-only tab (AssetIdScrollViewer, further down) instead of being buried inside this screen. -->
      <ScrollViewer x:Name="WindowsSetupScrollViewer" Grid.Row="2" Padding="24,0,24,6" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <Grid x:Name="WindowsSetupPanel">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Computer Rename -->
          <Border Grid.Column="0" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16">
            <DockPanel LastChildFill="True">
              <Button x:Name="RenameComputerButton" Content="Rename Computer" HorizontalAlignment="Left" DockPanel.Dock="Bottom"
                      Padding="18,8" Background="#38BDF8" Foreground="#08131A" BorderThickness="0" FontSize="12.5" FontWeight="Bold"/>
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Canvas Width="16" Height="16" Margin="0,0,9,0">
                    <Rectangle Canvas.Left="1.5" Canvas.Top="3.5" Width="13" Height="9" RadiusX="1.4" RadiusY="1.4" Stroke="#38BDF8" StrokeThickness="1.4"/>
                    <Line X1="4" Y1="9.5" X2="6" Y2="9.5" Stroke="#38BDF8" StrokeThickness="1.4"/>
                  </Canvas>
                  <TextBlock Text="Computer Rename" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>
                <TextBlock Text="Rename this device. A restart is required to apply the change." Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="CURRENT NAME" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                <Border Background="#14161B" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,3,0,9">
                  <TextBlock x:Name="CurrentComputerNameText" Text="-" Foreground="#9A9EA8" FontSize="13"/>
                </Border>

                <TextBlock Text="NEW NAME" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                <TextBox x:Name="NewComputerNameTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="12,6" FontSize="13" Margin="0,3,0,3"/>
                <TextBlock Text="Letters, numbers, one hyphen, max 15 characters" Foreground="#6B6F79" FontSize="10.5" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <TextBlock Text="AFTER RENAME" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Restarting a computer is an immediate, hard-to-reverse action, so "Restart Later" (today's existing behavior: rename now, restart whenever the technician chooses) is the default selection; "Restart Now" is an explicit opt-in, never the default. -->
                  <Border x:Name="RestartLaterOption" Grid.Column="0" Background="#2438BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="0,7" Cursor="Hand">
                    <TextBlock x:Name="RestartLaterOptionText" Text="Restart Later" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  </Border>
                  <Border x:Name="RestartNowOption" Grid.Column="2" Background="Transparent" BorderBrush="#3A3E48" BorderThickness="1" CornerRadius="6" Padding="0,7" Cursor="Hand">
                    <TextBlock x:Name="RestartNowOptionText" Text="Restart Now" Foreground="#9A9EA8" FontSize="12" HorizontalAlignment="Center"/>
                  </Border>
                </Grid>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Create Local Standard User -->
          <Border Grid.Column="2" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16">
            <DockPanel LastChildFill="True">
              <Button x:Name="CreateUserButton" Content="Create User" HorizontalAlignment="Left" DockPanel.Dock="Bottom"
                      Padding="18,7" Background="#38BDF8" Foreground="#08131A" BorderThickness="0" FontSize="12.5" FontWeight="Bold"/>
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Canvas Width="16" Height="16" Margin="0,0,9,0">
                    <Ellipse Canvas.Left="5" Canvas.Top="2" Width="6" Height="6" Stroke="#38BDF8" StrokeThickness="1.4"/>
                    <Path Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M2 14c0-3 2.7-5 6-5s6 2 6 5"/>
                  </Canvas>
                  <TextBlock Text="Local Standard User" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>
                <TextBlock Text="Create a non-administrator local account for the assigned user." Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="EXISTING" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,4"/>
                <StackPanel x:Name="LocalUsersListPanel" Margin="0,0,0,10"/>

                <TextBlock Text="ADD NEW USER" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,4"/>
                <!-- Username and Full Name side by side instead of stacked: this card has the most going on of the three (existing users list, password toggle, both password fields), so it needs to be genuinely more compact, not just bottom-anchored, to avoid dwarfing Computer Rename and Power & Sleep when all three stretch to an equal height. -->
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="USERNAME" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                    <TextBox x:Name="NewUserNameTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,6" FontSize="13" Margin="0,3,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="FULL NAME (OPTIONAL)" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                    <TextBox x:Name="NewUserFullNameTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,6" FontSize="13" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Blank-password local accounts are unusual enough to require an explicit opt-in, so "Set Password" (today's existing behavior) is the default selection, matching the Restart Later/Restart Now pattern on the Computer Rename card. -->
                  <Border x:Name="SetPasswordOption" Grid.Column="0" Background="#2438BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="0,7" Cursor="Hand">
                    <TextBlock x:Name="SetPasswordOptionText" Text="Set Password" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  </Border>
                  <Border x:Name="NoPasswordOption" Grid.Column="2" Background="Transparent" BorderBrush="#3A3E48" BorderThickness="1" CornerRadius="6" Padding="0,7" Cursor="Hand">
                    <TextBlock x:Name="NoPasswordOptionText" Text="No Password" Foreground="#9A9EA8" FontSize="12" HorizontalAlignment="Center"/>
                  </Border>
                </Grid>

                <StackPanel x:Name="NewUserPasswordFieldsPanel">
                  <TextBlock Text="PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <PasswordBox x:Name="NewUserPasswordBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="12,6" FontSize="13" Margin="0,3,0,5"/>
                  <TextBlock Text="CONFIRM PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <PasswordBox x:Name="NewUserConfirmPasswordBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="12,6" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <Border x:Name="NoPasswordNoticeBox" Background="#14F2555A" BorderBrush="#3DF2555A" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,0,0,12" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Canvas Grid.Column="0" Width="12" Height="12" Margin="0,1,7,0" VerticalAlignment="Top">
                      <Path Stroke="#F2555A" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M6 1l5.2 9H0.8L6 1z"/>
                      <Line X1="6" Y1="4.6" X2="6" Y2="7.2" Stroke="#F2555A" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                      <Line X1="6" Y1="8.6" X2="6" Y2="8.75" Stroke="#F2555A" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                    </Canvas>
                    <!-- A horizontal StackPanel gives its children unconstrained width, so TextWrapping="Wrap" never actually wrapped: the text just ran on and got clipped at the card's edge. A Grid column constrains the text to the remaining width, so it wraps as intended. -->
                    <TextBlock Grid.Column="1" Text="This account will sign in with no password. By default, Windows only allows this at the console, not over the network." Foreground="#D9A5A7" FontSize="10.5" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Power and Sleep Settings -->
          <Border Grid.Column="4" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16">
            <DockPanel LastChildFill="True">
              <Button x:Name="ApplyPowerSettingsButton" Content="Apply Power Settings" HorizontalAlignment="Left" DockPanel.Dock="Bottom"
                      Padding="18,8" Background="#38BDF8" Foreground="#08131A" BorderThickness="0" FontSize="12.5" FontWeight="Bold"/>
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Canvas Width="16" Height="16" Margin="0,0,9,0">
                    <Line X1="8" Y1="1.5" X2="8" Y2="7.5" Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                    <Path Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M4.2 3.6a6 6 0 108 0"/>
                  </Canvas>
                  <TextBlock Text="Power &amp; Sleep" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>
                <TextBlock Text="Recommended sleep timeouts for company deployment devices." Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="CURRENT" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                  <TextBlock Text="Plugged in: " Foreground="#9A9EA8" FontSize="12"/>
                  <TextBlock x:Name="CurrentPluggedInText" Text="-" Foreground="#E8E9EC" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="On battery: " Foreground="#9A9EA8" FontSize="12"/>
                  <TextBlock x:Name="CurrentBatteryText" Text="-" Foreground="#E8E9EC" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Text="APPLY NEW TIMEOUTS" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,4"/>
                <TextBlock Text="PLUGGED IN (MINUTES)" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                <TextBox x:Name="PluggedInMinutesTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="12,6" FontSize="13" Margin="0,3,0,7"/>
                <TextBlock Text="ON BATTERY (MINUTES)" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                <TextBox x:Name="BatteryMinutesTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="12,6" FontSize="13" Margin="0,3,0,0"/>
                <TextBlock Text="Minutes, 0 to 1440. Enter 0 for Never." Foreground="#6B6F79" FontSize="10.5" Margin="0,5,0,12" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Lenovo Asset ID content: its own ThinkPad-only tab now, matching NavAssetId/AssetIdToolbar's Collapsed default. The card no longer needs its own accent border/icon-chip/"THINKPAD" pill: those existed to make it stand out while buried inside Windows Setup; the toolbar above already establishes "Lenovo Asset ID" now that it has its own tab, so the card matches Device Details' plain card style instead. Fields are pre-filled from the current Sample.txt (if WinAIA is installed and already has values) and every field is optional. -->
      <ScrollViewer x:Name="AssetIdScrollViewer" Grid.Row="2" Padding="24,4,24,24" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <Border Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="20" VerticalAlignment="Top">
          <DockPanel LastChildFill="True">
            <Button x:Name="SaveAssetIdButton" Content="Save Asset ID" HorizontalAlignment="Left" DockPanel.Dock="Bottom" Margin="0,20,0,0"
                    Padding="18,8" Background="#38BDF8" Foreground="#08131A" BorderThickness="0" FontSize="12.5" FontWeight="Bold"/>
            <StackPanel>
              <!-- No repeated "Lenovo Asset ID" title here: the toolbar right above this card already says that, and this is the only card on the page, so a second identical heading was just noise, confirmed by a real screenshot. Went from 11 fields crammed into a single narrow row (which clipped real values like "VILLACORTA, JOHN PAUL..." and "IT ASSISTANT") back to 3 columns / up to 2 rows per group: this screen has its own full page now (no longer squeezed alongside three other cards on Windows Setup), so there's no reason to keep fields this narrow. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="36"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="OWNER DATA" FontSize="11" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="OWNER NAME" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetOwnerNameTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,10"/>
                  <TextBlock Text="DEPARTMENT" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetDepartmentTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                  <TextBlock Text="LOCATION" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetLocationTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,10"/>
                  <TextBlock Text="PHONE NUMBER" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetPhoneNumberTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4">
                  <TextBlock Text="POSITION" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetOwnerPositionTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Width="1" Background="#2C2F38" HorizontalAlignment="Center" Margin="0,3,0,0"/>

                <TextBlock Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="5" Text="ASSET DATA (DATES AS YYYYMMDD)" FontSize="11" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1" Grid.Column="6">
                  <TextBlock Text="PURCHASE DATE" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetPurchaseDateTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,10"/>
                  <TextBlock Text="LAST INVENTORIED" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetLastInventoriedTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="8">
                  <TextBlock Text="WARRANTY END" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetWarrantyEndTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,10"/>
                  <TextBlock Text="WARRANTY DURATION (MONTHS)" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetWarrantyDurationTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="10">
                  <TextBlock Text="AMOUNT" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetAmountTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,10"/>
                  <TextBlock Text="ASSET NUMBER" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79"/>
                  <TextBox x:Name="AssetNumberTextBox" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#3A3E48" BorderThickness="1" Padding="10,7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </DockPanel>
        </Border>
      </ScrollViewer>

      <!-- Device Details content: three cards, grouped sections inside each -->
      <ScrollViewer x:Name="DeviceDetailsScrollViewer" Grid.Row="2" Padding="24,2,24,12" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <Grid x:Name="DeviceDetailsPanel">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Identity & Network -->
          <Border Grid.Column="0" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Canvas Width="16" Height="16" Margin="0,0,9,0">
                  <Rectangle Canvas.Left="2" Canvas.Top="3" Width="12" Height="10" RadiusX="1.5" RadiusY="1.5" Stroke="#38BDF8" StrokeThickness="1.4"/>
                  <Line X1="4.5" Y1="6" X2="9" Y2="6" Stroke="#38BDF8" StrokeThickness="1.3"/>
                  <Line X1="4.5" Y1="8.5" X2="11.5" Y2="8.5" Stroke="#38BDF8" StrokeThickness="1.3"/>
                </Canvas>
                <TextBlock Text="Identity &amp; Network" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

              <TextBlock Text="IDENTITY" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer Name" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceComputerNameText" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Manufacturer" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceManufacturerText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceModelText" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Serial Number" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceSerialNumberText" Grid.Row="3" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="BIOS Version" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceBiosVersionText" Grid.Row="4" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Asset Tag" Foreground="#9A9EA8" FontSize="12"/>
                <TextBlock x:Name="DeviceAssetTagText" Grid.Row="5" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" TextWrapping="Wrap"/>
              </Grid>

              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,14,0,14"/>

              <TextBlock Text="NETWORK" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Network Type" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceNetworkTypeText" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceIPAddressText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="MAC Address" Foreground="#9A9EA8" FontSize="12"/>
                <TextBlock x:Name="DeviceMacAddressText" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" TextWrapping="Wrap"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- System & Session -->
          <Border Grid.Column="2" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Canvas Width="16" Height="16" Margin="0,0,9,0">
                  <Rectangle Canvas.Left="2" Canvas.Top="2" Width="12" Height="9" RadiusX="1" RadiusY="1" Stroke="#38BDF8" StrokeThickness="1.4"/>
                  <Line X1="6" Y1="14" X2="10" Y2="14" Stroke="#38BDF8" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                  <Line X1="8" Y1="11" X2="8" Y2="14" Stroke="#38BDF8" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                </Canvas>
                <TextBlock Text="System &amp; Session" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

              <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="OS Edition" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceOSEditionText" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="OS Version" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceOSVersionText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Build Number" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceOSBuildNumberText" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Architecture" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceOSArchitectureText" Grid.Row="3" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Domain/Workgroup" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceDomainWorkgroupText" Grid.Row="4" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Activation" Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <Border x:Name="DeviceActivationStatusPill" Grid.Row="5" Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#23262E" Margin="0,0,0,5">
                  <TextBlock x:Name="DeviceActivationStatusText" Text="-" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Last Update" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceLastUpdateText" Grid.Row="6" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Uptime" Foreground="#9A9EA8" FontSize="12"/>
                <TextBlock x:Name="DeviceUptimeText" Grid.Row="7" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" TextWrapping="Wrap"/>
              </Grid>

              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,14,0,14"/>

              <TextBlock Text="SESSION" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Logged User" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceLoggedUserText" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Administrator" Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center"/>
                <Border x:Name="DeviceAdminStatusPill" Grid.Row="1" Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#23262E">
                  <TextBlock x:Name="DeviceAdminStatusText" Text="-" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Power & Hardware -->
          <Border Grid.Column="4" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Canvas Width="16" Height="16" Margin="0,0,9,0">
                  <Ellipse Canvas.Left="5" Canvas.Top="2" Width="6" Height="6" Stroke="#38BDF8" StrokeThickness="1.3"/>
                  <Path Stroke="#38BDF8" StrokeThickness="1.3" StrokeStartLineCap="Round" Data="M2 14c0-3 2.7-5 6-5s6 2 6 5"/>
                  <Line X1="13" Y1="2" X2="13" Y2="5.5" Stroke="#38BDF8" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                </Canvas>
                <TextBlock Text="Power &amp; Hardware" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

              <TextBlock Text="POWER" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Power Plan" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DevicePowerPlanText" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sleep" Foreground="#9A9EA8" FontSize="12"/>
                <TextBlock x:Name="DeviceSleepText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" TextWrapping="Wrap"/>
              </Grid>

              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,14,0,14"/>

              <TextBlock Text="HARDWARE" FontSize="10.5" FontWeight="Bold" Foreground="#6B6F79" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Processor" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceProcessorText" Grid.Row="0" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceMemoryText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Storage" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceStorageText" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="TPM" Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <Border x:Name="DeviceTpmStatusPill" Grid.Row="3" Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#23262E" Margin="0,0,0,5">
                  <TextBlock x:Name="DeviceTpmStatusText" Text="-" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Secure Boot" Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <Border x:Name="DeviceSecureBootStatusPill" Grid.Row="4" Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#23262E" Margin="0,0,0,5">
                  <TextBlock x:Name="DeviceSecureBootStatusText" Text="-" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Battery Health" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceBatteryHealthText" Grid.Row="5" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Antivirus" Foreground="#9A9EA8" FontSize="12" Margin="0,0,0,5"/>
                <TextBlock x:Name="DeviceAntivirusStatusText" Grid.Row="6" Grid.Column="1" Text="-" Foreground="#E8E9EC" FontSize="12.5" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Firewall" Foreground="#9A9EA8" FontSize="12" VerticalAlignment="Center"/>
                <Border x:Name="DeviceFirewallStatusPill" Grid.Row="7" Grid.Column="1" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#23262E">
                  <TextBlock x:Name="DeviceFirewallStatusText" Text="-" Foreground="#6B6F79" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Temp Cleanup content: three fixed cards (User Temp, Windows Temp, Prefetch), each with a card-level checkbox toggling whether that location is included in Clean Selected -->
      <ScrollViewer x:Name="TempCleanupScrollViewer" Grid.Row="2" Padding="24,4,24,24" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- User Temp -->
          <Border x:Name="TempCleanupUserTempCard" Grid.Column="0" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16" Cursor="Hand" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="TempCleanupUserTempCheckbox" Width="18" Height="18" CornerRadius="5" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0">
                  <Canvas Width="10" Height="10">
                    <Path x:Name="TempCleanupUserTempCheckmark" Stroke="#0B1116" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1.5 5L4 7.5L8.5 2"/>
                  </Canvas>
                </Border>
                <TextBlock Text="User Temp" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
              <TextBlock x:Name="TempCleanupUserTempPathText" Text="-" Foreground="#9A9EA8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock x:Name="TempCleanupUserTempSummaryText" Text="Scanning..." Foreground="#E8E9EC" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Windows Temp -->
          <Border x:Name="TempCleanupWindowsTempCard" Grid.Column="2" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16" Cursor="Hand" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="TempCleanupWindowsTempCheckbox" Width="18" Height="18" CornerRadius="5" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0">
                  <Canvas Width="10" Height="10">
                    <Path x:Name="TempCleanupWindowsTempCheckmark" Stroke="#0B1116" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1.5 5L4 7.5L8.5 2"/>
                  </Canvas>
                </Border>
                <TextBlock Text="Windows Temp" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
              <TextBlock x:Name="TempCleanupWindowsTempPathText" Text="-" Foreground="#9A9EA8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock x:Name="TempCleanupWindowsTempSummaryText" Text="Scanning..." Foreground="#E8E9EC" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Prefetch -->
          <Border x:Name="TempCleanupPrefetchCard" Grid.Column="4" Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="10" Padding="16" Cursor="Hand" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="TempCleanupPrefetchCheckbox" Width="18" Height="18" CornerRadius="5" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0">
                  <Canvas Width="10" Height="10">
                    <Path x:Name="TempCleanupPrefetchCheckmark" Stroke="#0B1116" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1.5 5L4 7.5L8.5 2"/>
                  </Canvas>
                </Border>
                <TextBlock Text="Prefetch" Foreground="#E8E9EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="#2C2F38" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
              <TextBlock x:Name="TempCleanupPrefetchPathText" Text="-" Foreground="#9A9EA8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock x:Name="TempCleanupPrefetchSummaryText" Text="Scanning..." Foreground="#E8E9EC" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Placeholder for not-yet-built screens -->
      <TextBlock x:Name="PlaceholderText" Grid.Row="2" Text="Coming soon"
                 Foreground="#6B6F79" FontSize="14"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="Collapsed"/>
    </Grid>
  </Grid>
  </DockPanel>

  <!-- Install/uninstall completion modal overlay -->
  <Border x:Name="CompletionModalOverlay" Background="#B0000000" Visibility="Collapsed">
    <Border Background="#1C1F26" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="12"
            Width="480" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <Canvas x:Name="CompletionModalIconSuccess" Width="22" Height="22" Margin="0,0,12,0">
            <Ellipse Width="22" Height="22" Stroke="#34D399" StrokeThickness="1.6"/>
            <Path Stroke="#34D399" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6.5 11l3 3L16 7"/>
          </Canvas>
          <Canvas x:Name="CompletionModalIconWarning" Width="22" Height="22" Margin="0,0,12,0" Visibility="Collapsed">
            <Path Stroke="#F2555A" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M11 2.5l9.5 16.5H1.5L11 2.5z"/>
            <Line X1="11" Y1="9" X2="11" Y2="13.5" Stroke="#F2555A" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
            <Line X1="11" Y1="15.9" X2="11" Y2="16.1" Stroke="#F2555A" StrokeThickness="2" StrokeStartLineCap="Round"/>
          </Canvas>
          <TextBlock x:Name="CompletionModalTitleText" Text="-" Foreground="#E8E9EC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="CompletionModalCountsPanel" Orientation="Horizontal" Margin="34,10,0,4"/>

        <Border x:Name="CompletionModalDetailsCard" Background="#14161B" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,20" MaxHeight="280" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CompletionModalDetailsPanel"/>
          </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="CompletionModalCopyButton" Content="Copy Results" Margin="0,0,10,0"
                  Padding="18,9" Background="#23262E" Foreground="#E8E9EC" BorderBrush="#2C2F38" BorderThickness="1" FontSize="13"/>
          <Button x:Name="CompletionModalOkButton" Content="OK"
                  Padding="24,9" Background="#38BDF8" Foreground="#08131A" BorderThickness="0" FontSize="13" FontWeight="Bold"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
